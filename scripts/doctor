#!/usr/bin/env zsh
# Read-only health check: detection status + drift for every managed destination.
# Never writes anything.

set -euo pipefail
source "$(dirname "${(%):-%x}")/lib.sh"

core_content=$(render_core)
printf '%-12s %-11s %-45s %s\n' "TOOL" "DETECTED" "DESTINATION" "STATUS"
printf '%-12s %-11s %-45s %s\n' "----" "--------" "-----------" "------"

while IFS=$'\t' read -r tool detect dest mode; do
  dest_expanded=$(expand_path "$dest")
  if ! tool_detected "$detect"; then
    printf '%-12s %-11s %-45s %s\n' "$tool" "no" "$dest" "tool-absent"
    continue
  fi

  if [[ "$mode" == "manual" ]]; then
    if [[ -f "$dest_expanded" ]] && diff -q <(print -r -- "$core_content") "$dest_expanded" >/dev/null 2>&1; then
      printf '%-12s %-11s %-45s %s\n' "$tool" "yes" "$dest" "ready-for-manual-paste"
    else
      printf '%-12s %-11s %-45s %s\n' "$tool" "yes" "$dest" "paste-text-drifted"
    fi
    continue
  fi

  if [[ ! -f "$dest_expanded" ]]; then
    printf '%-12s %-11s %-45s %s\n' "$tool" "yes" "$dest_expanded" "missing"
    continue
  fi

  expected=$(render_for_mode "$mode" "$dest_expanded" "$core_content")
  if diff -q <(print -r -- "$expected") "$dest_expanded" >/dev/null 2>&1; then
    printf '%-12s %-11s %-45s %s\n' "$tool" "yes" "$dest_expanded" "in-sync"
  else
    printf '%-12s %-11s %-45s %s\n' "$tool" "yes" "$dest_expanded" "drifted"
  fi
done < <(manifest_rows)

echo
printf '%-12s %-11s %-45s %s\n' "SKILLS" "COUNT" "DESTINATION" "STATUS"
printf '%-12s %-11s %-45s %s\n' "------" "-----" "-----------" "------"

repo_skill_count=$(skill_dirs | wc -l | tr -d ' ')
while IFS=$'\t' read -r skill_label skill_detect skill_root; do
  dest_expanded=$(expand_path "$skill_root")
  if ! tool_detected "$skill_detect"; then
    printf '%-12s %-11s %-45s %s\n' "$skill_label" "-" "$skill_root" "tool-absent"
    continue
  fi
  if [[ ! -d "$dest_expanded" ]]; then
    printf '%-12s %-11s %-45s %s\n' "$skill_label" "$repo_skill_count" "$dest_expanded" "missing: run scripts/deploy"
    continue
  fi
  drifted=0 orphaned=0 absent=0
  for skill_dir in ${(f)"$(skill_dirs)"}; do
    name=$(basename "$skill_dir")
    if [[ ! -d "$dest_expanded/$name" ]]; then
      absent=$(( absent + 1 ))
    elif ! diff -qr --exclude=.managed-by "$skill_dir" "$dest_expanded/$name" >/dev/null 2>&1; then
      drifted=$(( drifted + 1 ))
    fi
  done
  # Orphans are only ever skills this repo deployed and later dropped. A skill
  # from another source has no marker, is reported separately, and is not drift.
  for existing in "$dest_expanded"/*/(N); do
    [[ -f "${existing%/}/.managed-by" ]] || continue
    [[ -d "$REPO_ROOT/skills/$(basename "${existing%/}")" ]] || orphaned=$(( orphaned + 1 ))
  done
  if (( drifted || orphaned || absent )); then
    skill_status="drifted:$drifted not-deployed:$absent orphaned:$orphaned"
  else
    skill_status="in-sync"
  fi
  printf '%-12s %-11s %-45s %s\n' "$skill_label" "$repo_skill_count" "$dest_expanded" "$skill_status"
done < <(skill_dest_rows)

echo
echo "METHOD LAYER (owned by construct; see manifests/skill-ownership.tsv)"
echo "--------------------------------------------------------------------"
"$SCRIPT_DIR/method-layer" check || true

echo
echo "SKILLS FROM OTHER SOURCES (not managed here; left untouched by deploy)"
echo "----------------------------------------------------------------------"
foreign_found=0
while IFS=$'\t' read -r skill_label skill_detect skill_root; do
  tool_detected "$skill_detect" || continue
  root=$(expand_path "$skill_root")
  for existing in "$root"/*/(N); do
    fname=$(basename "${existing%/}")
    [[ -f "${existing%/}/.managed-by" ]] && continue
    owner=$(owned_elsewhere_rows | awk -F'\t' -v n="$fname" '$2==n {print $1; exit}')
    printf '  %-10s %-28s %s\n' "$skill_label" "$fname" "${owner:-unrecognized source}"
    foreign_found=1
  done
done < <(skill_dest_rows)
(( foreign_found )) || echo "  none"

echo
echo "HOOKS"
echo "-----"
"$SCRIPT_DIR/hooks" check || true

echo
if "$SCRIPT_DIR/skills" lint >/dev/null 2>&1; then
  echo "skills lint: clean"
else
  echo "skills lint: FAILING; run 'scripts/skills lint' for details"
fi

if [[ -f "$REPO_ROOT/skills/CATALOG.md" ]] \
  && diff -q <("$SCRIPT_DIR/skills" _render_catalog 2>/dev/null || true) "$REPO_ROOT/skills/CATALOG.md" >/dev/null 2>&1; then
  echo "skills catalog: in-sync"
else
  echo "skills catalog: stale or missing; run 'scripts/skills catalog'"
fi

echo "tool paths last checked against vendor docs: $(awk -F': ' '/^# verified:/ {print $2; exit}' "$SKILL_MANIFEST")"

echo
echo "Run 'scripts/sync --dry-run' to preview fixes for drifted or missing entries."
