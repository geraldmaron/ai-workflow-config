#!/usr/bin/env zsh
# Manage the skills library: list, show, scaffold, and regenerate the catalog.
# The single source of truth for a skill's name/description is its SKILL.md
# frontmatter; skills/CATALOG.md is generated from it, never hand-edited.
# Usage: skills list | show <name> | new <name> | catalog | lint
set -euo pipefail
source "$(dirname "${(%):-%x}")/lib.sh"

CATALOG="$SKILLS_DIR/CATALOG.md"

frontmatter_field() {
  # frontmatter_field <file> <key>: value of a top-level frontmatter key.
  # Handles YAML folded/continued values: a description may wrap across many
  # indented lines, and reading only the first would silently truncate it.
  # Continuation lines are joined with a single space, matching YAML folding.
  awk -v key="$2" '
    NR==1 && $0=="---" { inside=1; next }
    inside && $0=="---" { exit }
    inside && !collecting && index($0, key ": ")==1 {
      value = substr($0, length(key)+3); collecting=1
      if (value ~ /^[>|][-+]?$/) value = ""   # block scalar: text starts on the next line
      next
    }
    collecting && /^[ \t]+[^ \t]/ {
      line = $0; sub(/^[ \t]+/, "", line); value = (value == "" ? line : value " " line); next
    }
    collecting { exit }
    END { if (collecting || value != "") print value }
  ' "$1"
}

frontmatter_keys() {
  # frontmatter_keys <file>: one top-level frontmatter key per line
  awk '
    NR==1 && $0=="---" { inside=1; next }
    inside && $0=="---" { exit }
    inside && /^[A-Za-z0-9_-]+:/ { sub(/:.*/, ""); print }
  ' "$1"
}

each_skill() {
  # each_skill <callback>: callback <name> <description> per skill, sorted
  local dir name desc
  for dir in "$SKILLS_DIR"/*/(N); do
    name=$(basename "$dir")
    [[ -f "$dir/SKILL.md" ]] || { log "warning: $name has no SKILL.md; skipped"; continue }
    desc=$(frontmatter_field "$dir/SKILL.md" "description")
    "$1" "$name" "$desc"
  done
}

render_catalog() {
  print -r -- "# Skills Catalog"
  print -r -- ""
  print -r -- "> Generated by \`scripts/skills catalog\` from each skill's SKILL.md frontmatter."
  print -r -- "> Do not hand-edit. \`scripts/doctor\` flags this file when it is stale."
  print -r -- ""
  print -r -- "| Skill | Use when |"
  print -r -- "|---|---|"
  local row
  row() { print -r -- "| [${1}](${1}/SKILL.md) | ${2} |" }
  each_skill row
}

# --- lint -------------------------------------------------------------------
# Structural rules every skill must satisfy to be loadable and well-behaved.
# Errors fail the lint (exit 1); warnings are advisory. Keep every rule
# mechanically checkable; style opinions belong in review, not here.

LINT_ERRORS=0
LINT_WARNINGS=0

# Paths that exist on one machine only. Anything deployed to other machines
# (skills, core preferences) must not contain them.
MACHINE_PATH_RE='(/Users/|/home/[a-z]|~/Developer/|~/Documents/|/opt/homebrew/)'

# Skill names are functional noun phrases: what the skill does, not a persona,
# a metaphor, or a vendor's product. A name like devils-advocate or jira-helper
# stops describing the skill the moment the persona or the product changes.
NAME_BANNED_RE='(^|-)(advocate|devil|devils|expert|guru|ninja|wizard|persona|hat|hats|buddy|coach|slack|notion|jira|obsidian|confluence|github|gitlab|linear|google|claude|anthropic|openai|gpt|gemini|copilot|cursor)(-|$)'

lint_emit() {
  # lint_emit <level> <skill> <message>
  # Note: plain assignment, not (( x++ )): post-increment from 0 evaluates to 0,
  # which is a non-zero exit status and would trip `set -e` on the first finding.
  if [[ "$1" == "error" ]]; then
    LINT_ERRORS=$(( LINT_ERRORS + 1 ))
  else
    LINT_WARNINGS=$(( LINT_WARNINGS + 1 ))
  fi
  printf '%-5s %-28s %s\n' "$1" "$2" "$3"
}

lint_one() {
  # lint_one <skill-dir>: emits findings for one skill
  local dir="$1" name file fname fdesc key
  name=$(basename "$dir")
  file="$dir/SKILL.md"

  if [[ ! -f "$file" ]]; then
    lint_emit error "$name" "no SKILL.md; the directory will be deployed empty"
    return 0
  fi

  if [[ "$name" != [a-z]*[a-z0-9] || "$name" == *[^a-z0-9-]* ]]; then
    lint_emit error "$name" "directory name is not kebab-case"
  fi
  if print -r -- "$name" | grep -qE "$NAME_BANNED_RE"; then
    lint_emit error "$name" "name uses a persona, metaphor, or vendor word; name the function instead"
  fi

  # Frontmatter must open on line 1 and close, or the whole file is ignored.
  if [[ "$(head -1 "$file")" != "---" ]]; then
    lint_emit error "$name" "line 1 is not '---'; frontmatter missing, skill will not load"
    return 0
  fi
  if ! awk 'NR>1 && $0=="---" {found=1; exit} END {exit !found}' "$file"; then
    lint_emit error "$name" "frontmatter is never closed with '---'"
    return 0
  fi

  fname=$(frontmatter_field "$file" "name")
  fdesc=$(frontmatter_field "$file" "description")

  if [[ -z "$fname" ]]; then
    lint_emit error "$name" "frontmatter has no 'name:'"
  elif [[ "$fname" != "$name" ]]; then
    lint_emit error "$name" "frontmatter name '$fname' does not match directory"
  fi

  # A plain (unquoted, unfolded) YAML value may not contain ": " or " #". Some
  # hosts parse leniently and load it anyway; strict parsers drop the skill.
  local rawdesc
  rawdesc=$(awk 'NR>1 && /^---$/ {exit} /^description:/ {sub(/^description:[ \t]*/, ""); print; exit}' "$file")
  if [[ -n "$rawdesc" && "$rawdesc" != [\>\|\"\']* ]] && [[ "$fdesc" == *": "* || "$fdesc" == *" #"* ]]; then
    lint_emit error "$name" "description is a plain YAML value containing ': ' or ' #'; use 'description: >-' so strict parsers can read it"
  fi

  if [[ -z "$fdesc" ]]; then
    lint_emit error "$name" "frontmatter has no 'description:'; nothing tells a session when to load it"
  else
    # The description is the only thing a model sees before loading the skill.
    # It has to name the triggering situation, not the topic.
    case "$fdesc" in
      "Use when"*|"Use before"*|"Use after"*|"Use for"*|"Use during"*) ;;
      *) lint_emit error "$name" "description must open with a trigger (Use when/before/after/for/during)" ;;
    esac
    if (( ${#fdesc} > 1024 )); then
      lint_emit error "$name" "description is ${#fdesc} chars (Claude Code caps it at 1024)"
    elif (( ${#fdesc} < 40 )); then
      lint_emit warn "$name" "description is only ${#fdesc} chars; likely too vague to match on"
    fi
    if [[ "$fdesc" == *"<"*">"* ]]; then
      lint_emit error "$name" "description still contains scaffold placeholder text"
    fi
  fi

  for key in ${(f)"$(frontmatter_keys "$file")"}; do
    case "$key" in
      name|description|license|compatibility|metadata|allowed-tools) ;;
      *) lint_emit warn "$name" "unrecognized frontmatter key '$key'; ignored by Claude Code" ;;
    esac
  done

  if ! grep -q '^# ' "$file"; then
    lint_emit warn "$name" "no H1 title heading"
  fi

  # --- portability rules, per skills/AUTHORING.md in the construct repo -------
  # These skills must survive the naked-file test: one file, pasted into any
  # agent harness, on any model family, with no checkout of this repo present.

  # A skill leaning on a specific host's features loses them in transit.
  local hostref
  hostref=$(grep -noiE '\b(websearch|webfetch|subagent|sub-agent|claude code|claude\.ai|cursor|copilot|mcp server|create an artifact)\b' "$file" 2>/dev/null | head -3 || true)
  if [[ -n "$hostref" ]]; then
    lint_emit error "$name" "names a host tool or vendor feature (${hostref//$'\n'/, }); write a capability-honesty clause instead"
  fi

  # Obligations must be checkable by a reader, since no harness machinery
  # travels with the file.
  if ! grep -qiE '^## .*(record|gates)' "$file"; then
    lint_emit error "$name" "no closing gates or record section; nothing makes its obligations checkable"
  fi
  if ! grep -qiE 'enforce' "$file"; then
    lint_emit error "$name" "no enforcement statement saying what does and does not enforce this file"
  fi

  # Absolute paths and repo-internal paths break severability.
  if grep -qE "$MACHINE_PATH_RE" "$file"; then
    lint_emit error "$name" "contains an absolute or machine-specific path"
  fi

  local lines
  lines=$(grep -c '' "$file" || true)
  if (( lines > 500 )); then
    lint_emit error "$name" "$lines lines (hard limit 500)"
  elif (( lines < 150 )); then
    lint_emit warn "$name" "$lines lines; below the 250-450 working range; likely judgment-only guidance without literal output shapes"
  fi
  # A skill with no stated boundary is a trigger with no brake. The standard
  # puts the stand-down inside the scope section; an explicit "When NOT to use"
  # heading satisfies it equally. Accept either rather than forcing a redundant
  # second section on skills that follow the section grammar.
  if ! grep -qiE '^## .*(when not to use|stand down|stand-down)' "$file"; then
    lint_emit error "$name" "no stand-down rule; state when the skill must not engage, in scope or its own section"
  fi
  if grep -q '^<The procedure' "$file"; then
    lint_emit error "$name" "body is still the unedited scaffold"
  fi
}

# The prose checker ships with the written-voice skill, which construct owns.
# Use an installed copy rather than a second one here; skip when absent.
prose_checker() {
  local root
  for root in ${(f)"$(skill_dest_roots)"}; do
    [[ -f "$root/written-voice/scripts/voice-check.py" ]] && { print -r -- "$root/written-voice/scripts/voice-check.py"; return 0 }
  done
  return 1
}

lint_prose() {
  # lint_prose <skill-dir> - warn on AI-writing tells in the skill's own prose.
  # Skills are instructions, and models imitate the style of their instructions.
  local dir="$1" checker="$2" name out tells
  name=$(basename "$dir")
  out=$(python3 "$checker" "$dir/SKILL.md" 2>/dev/null || true)
  tells=$(print -r -- "$out" \
    | grep -E "^(negate-then-correct total|banned tics|stock phrases|filler adverbs|em dashes|'serves as' copulas|'not just X but Y'|emoji headings):" \
    | grep -vE ': (0|none)( |$)|OK$' || true)
  [[ -n "$tells" ]] && lint_emit warn "$name" "AI-writing tells: ${tells//$'\n'/; }"
  return 0
}

lint_core() {
  # The core preferences load on every machine; a path from this one breaks there.
  local f
  for f in "$REPO_ROOT"/core/*.md(N); do
    if grep -qE "$MACHINE_PATH_RE" "$f"; then
      lint_emit error "core/${f:t}" "contains a machine-specific path; move it to local/GLOBAL.local.md"
    fi
  done
}

lint_all() {
  local dir owner name note checker=""
  lint_core
  if command -v python3 >/dev/null 2>&1; then
    checker=$(prose_checker || true)
  fi
  for dir in ${(f)"$(skill_dirs)"}; do
    lint_one "$dir"
    [[ -n "$checker" ]] && lint_prose "$dir" "$checker"
  done
  # Ownership policy: a concept another source owns must not be redefined here.
  # Two skills firing on the same situation collide in the host's skills
  # directory and the last deploy silently wins.
  while IFS=$'\t' read -r owner name note; do
    [[ -n "$name" ]] || continue
    if [[ -d "$SKILLS_DIR/$name" ]]; then
      lint_emit error "$name" "owned by '$owner' ($note); remove it here, see manifests/skill-ownership.tsv"
    fi
  done < <(owned_elsewhere_rows)
}

cmd="${1:-list}"
case "$cmd" in
  list)
    local print_row
    print_row() { printf '%-28s %s\n' "$1" "$2" }
    each_skill print_row
    ;;

  show)
    [[ -n "${2:-}" ]] || die "usage: skills show <name>"
    [[ -f "$SKILLS_DIR/$2/SKILL.md" ]] || die "no such skill: $2 (try: skills list)"
    cat "$SKILLS_DIR/$2/SKILL.md"
    ;;

  new)
    [[ -n "${2:-}" ]] || die "usage: skills new <name> (kebab-case)"
    name="$2"
    [[ "$name" == [a-z]*[a-z0-9] && "$name" != *[^a-z0-9-]* ]] || die "name must be kebab-case: $name"
    dir="$SKILLS_DIR/$name"
    [[ -e "$dir" ]] && die "skill already exists: $name"
    mkdir -p "$dir"
    cat > "$dir/SKILL.md" <<EOF
---
name: $name
description: Use when <trigger: the situation, not the topic>. <What following it produces.>
---

# ${(C)name//-/ }

<The procedure. Numbered steps a session can follow without this conversation.>

## When NOT to use

<The honest boundary: situations where this skill wastes effort or misleads.>
EOF
    "$0" catalog
    log "scaffolded $dir/SKILL.md; edit it, then deploy with scripts/deploy"
    ;;

  catalog)
    backup_path "$CATALOG"
    atomic_write "$CATALOG" "$(render_catalog)"
    log "wrote $CATALOG"
    ;;

  lint)
    lint_all
    if (( LINT_ERRORS )); then
      log "skills lint: $LINT_ERRORS error(s), $LINT_WARNINGS warning(s)"
      exit 1
    fi
    log "skills lint: clean ($LINT_WARNINGS warning(s))"
    ;;

  _field)
    # Internal: one frontmatter field of a SKILL.md, used by scripts/evals.
    frontmatter_field "$2" "$3"
    ;;

  _render_catalog)
    # Internal: used by doctor to detect a stale catalog without writing.
    render_catalog
    ;;

  *)
    die "usage: skills list | show <name> | new <name> | catalog | lint"
    ;;
esac
